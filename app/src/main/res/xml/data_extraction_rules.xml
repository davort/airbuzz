<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing AirBuzz keeps leaves the phone: no cloud backup and no copy to a new phone (PRIVACY.md). On Android 12 and
     later, allowBackup="false" stops cloud backup only; these rules also stop device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
